.env
frontend/node_modules/
frontend/dist/
__pycache__/
*.py[cod]
.venv/
venv/

# 데이터 산출물
# 레포가 비공개라 수집 데이터를 함께 버전 관리한다 — 다른 컴퓨터에서 바로 이어받기 위해서다.
# ⚠️ 공개로 되돌릴 경우 반드시 아래 예외(!)를 먼저 지워야 한다.
#    수집분은 GeekNews·HN의 요약문이라, 공개 저장소에 두면 재배포에 해당한다(CLAUDE.md 원칙).
data/raw/*
data/processed/*
data/checkpoints/*
!data/**/.gitkeep
*.db
*.parquet

# 2026-08-31: DB를 Supabase(Postgres, DATABASE_URL)로 전환하면서 위 예외를 걷어냈다.
# 두 컴퓨터가 각자 로컬 sqlite radar.db를 git으로 주고받던 방식이 파일 크기(GitHub
# 100MB 제한에 근접)와 바이너리 병합 충돌(두 세션이 동시에 손대면 git이 못 합친다)
# 둘 다 문제였다. 이제 DB는 실시간 공유되니 git으로 옮길 이유가 없다.
# raw/*.jsonl·checkpoints도 같은 이유로 도로 로컬 전용으로 되돌린다 — 각 컴퓨터가
# 각자 크롤링한 이력일 뿐, 공유 DB가 진실 소스가 된 이상 서로 합칠 필요가 없다.
# WAL/SHM은 SQLite 실행 중에만 생기는 임시 파일이다. 커밋하면 안 된다.
data/*.db-wal
data/*.db-shm

logs/
logs_*.txt
reports/*
!reports/.gitkeep

# 서버 실행 로그 (uvicorn을 백그라운드로 띄울 때 생긴다)
data/*.log

# 로고 원본(수동으로 둔 파일). 화면은 글자 로고를 쓴다.
logo/

# 파이프라인 중복 실행 방지 잠금 (실행 중에만 존재).
#   ★ 저장소에 들어가면 안 된다. clone한 PC가 이 잠금을 '다른 배치가 실행 중'으로
#     읽어서 첫 배치를 2시간 동안 건너뛴다 — 그것도 종료 코드 0으로.
data/.pipeline.lock

# Claude Code 스킬 플러그인 로컬 캐시/워크트리 — 이 컴퓨터의 도구 상태일 뿐
# 프로젝트 코드가 아니다. 다른 컴퓨터·사람은 각자 스킬을 따로 설치한다.
.agents/
.claude/
skills-lock.json
