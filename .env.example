# DB 접속 (비워두면 config.yaml의 db.url 사용 = sqlite:///data/radar.db)
#   배포 시 이 한 줄만 바꾸면 엔진이 교체된다. 코드 수정 불필요.
#   예) postgresql+psycopg://user:password@dbhost:5432/aitrend
DATABASE_URL=

# 네이버 검색 API (소상공인 축 뉴스 수집) — sobiz 프로젝트와 동일 키 사용 가능
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# 공공데이터포털 (기업마당·나라장터·국회 의안)
DATA_GO_KR_KEY=your_service_key_here

# GitHub (Releases API — 없어도 동작하나 rate limit 60/hr로 제한됨)
GITHUB_TOKEN=

# AI 해설 레이어 (L1/L2/L3)
ANTHROPIC_API_KEY=your_api_key_here

# 메일 push (3주차)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=            # 쉼표 구분

# 메일의 '전체 보기' 링크가 가리킬 주소. 비우면 http://localhost:8000 을 쓴다.
# 사내 서버에 배포하면 여기를 그 주소로 바꾼다.
WEB_BASE_URL=

# 크롤링 시 User-Agent에 넣을 담당자 연락처 (GeekNews 백필 등)
CONTACT_EMAIL=your_email@example.com
